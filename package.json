{
  "name": "sports-festival-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "entries": "node scripts/generate-entries.mjs",
    "entries:upload": "node scripts/upload-entries.mjs",
    "festival:data": "node scripts/generate-festival-data.mjs",
    "festival:sync": "node scripts/generate-festival-data.mjs --sync",
    "predev": "npm run entries && npm run festival:sync",
    "dev": "next dev",
    "prebuild": "npm run entries && npm run festival:sync",
    "build": "next build",
    "build:pages": "npm run entries && npm run festival:data && next build github-pages",
    "start": "next start",
    "lint": "npm run entries && npm run festival:data && next typegen && eslint && tsc --noEmit",
    "test": "npm run entries && npm run festival:data && vitest run",
    "db:login": "supabase login",
    "db:check": "node scripts/supabase-sql.mjs check",
    "db:sql": "node scripts/supabase-sql.mjs sql",
    "db:apply-casino": "node scripts/supabase-sql.mjs apply-casino"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
