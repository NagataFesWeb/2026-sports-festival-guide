# .env.local にコピーして値を入れる（.env* は git 管理外）

# --- Supabase（未設定なら開発時はサーバーのメモリ上の仮データで動く。本番では必須。
#     本番で未設定のまま起動すると例外で止まる。意図してメモリ実装で動かすときだけ ALLOW_MEMORY_DB=1） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用。クライアントに出さない
SUPABASE_SECRET_KEY=

# 出場表はローカルCSVを優先。CSVがないクラウドビルドでは非公開Storageから取得する。
# 省略時の保存先: festival-private / entries/2026.csv
# FESTIVAL_ENTRIES_BUCKET=festival-private
# FESTIVAL_ENTRIES_OBJECT=entries/2026.csv

# --- セッション署名の秘密鍵（16文字以上。本番では必須） ---
SESSION_SECRET=

# --- 実行委員ログイン ---
# Supabase 設定時は ADMIN_EMAIL のアドレスだけを Supabase Auth（メール＋パスワード）で認証する。
# 未設定時は下記の値で認証する（両方空なら開発時のみ admin@example.com / admin）
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- 開発用: メモリ DB を .data/db.json に保存しない場合は 0 ---
# DB_PERSIST=0
